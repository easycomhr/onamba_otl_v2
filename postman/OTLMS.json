  "item": [
    {
      "name": "Auth",
      "description": "POST /api/v1/auth/login — Public endpoint, không cần API key",
      "item": [
        {
          "name": "✅ Login Success",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_code\": \"{{test_employee_code}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has _token\", () => pm.expect(pm.response.json()._token).to.be.a('string').and.not.empty);",
                  "pm.test(\"user_info is array\", () => pm.expect(pm.response.json().user_info).to.be.an('array'));",
                  "pm.test(\"user_info has employee_code\", () => pm.expect(pm.response.json().user_info[0].employee_code).to.exist);",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('auth_token', pm.response.json()._token); }"
                ]
              }
            }
          ]
        },
